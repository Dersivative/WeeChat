server {
  listen 443 ssl;
  server_name cdn.test.dersivative.eu;

  ssl_certificate /etc/letsencrypt/live/test.dersivative.eu/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/test.dersivative.eu/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;

  root /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri =404;
  }
}
